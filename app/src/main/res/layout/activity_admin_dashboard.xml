<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#E91E63"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackAdmin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản Lý Cửa Hàng"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center" />

        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Khung thống kê -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Cột Doanh Thu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp"
                android:background="#FFF5F8">
                <TextView
                    android:id="@+id/tvAdminRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 đ"
                    android:textColor="#E91E63"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng Doanh Thu"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#22E91E63" />

            <!-- Cột Đơn Đã Bán -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="20dp">
                <TextView
                    android:id="@+id/tvAdminOrders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#333333"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đơn Đã Bán"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Các nút chức năng Admin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btnUploadProduct"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="+ Đăng Sản Phẩm Mới"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E91E63"
            android:layout_marginBottom="12dp"
            app:cornerRadius="8dp"/>

        <Button
            android:id="@+id/btnManageProducts"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Quản Lý Sản Phẩm"
            android:textSize="16sp"
            android:textColor="#E91E63"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="12dp"
            app:strokeColor="#E91E63"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"/>

        <Button
            android:id="@+id/btnManageOrders"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Danh Sách Đơn Hàng"
            android:textSize="16sp"
            android:textColor="#E91E63"
            android:backgroundTint="#FFFFFF"
            app:strokeColor="#E91E63"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"/>
    </LinearLayout>
</LinearLayout>