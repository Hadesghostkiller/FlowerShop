<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tổng cần thanh toán:"
        android:textSize="14sp"
        android:textColor="#666" />

    <TextView
        android:id="@+id/tvDialogTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 VND"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#E91E63"
        android:layout_marginTop="4dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Số tiền khách đưa">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomerMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="18sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiền thừa trả khách:"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 VND"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#4CAF50" />

    <Button
        android:id="@+id/btnConfirmCash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Xác nhận và xem hóa đơn"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63"
        android:enabled="false" />

</LinearLayout>